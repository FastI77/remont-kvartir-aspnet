@model IEnumerable<remont_kvartir.Models.PortfolioItem>
@{
    ViewData["Title"] = "Наши работы";
}

<section class="section-padding">
    <div class="container">
        <h2 class="section-title-center">Портфолио</h2>

        @if (!Model.Any())
        {
            <p class="text-center text-muted">Портфолио пока пустое.</p>
        }
        else
        {
            <div class="grid-3">
                @foreach (var item in Model)
                {
                    <div class="card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" style="width: 100%; height: 250px; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="width: 100%; height: 250px; background: #e5e5e5; display: flex; align-items: center; justify-content: center; color: #888;">
                                Нет фото
                            </div>
                        }
                        <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column;">
                            <h3 class="card-title" style="margin-bottom: 10px;">@item.Title</h3>
                            <p class="text-muted" style="flex-grow: 1; font-size: 15px;">@item.Description</p>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-card">Подробнее</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>