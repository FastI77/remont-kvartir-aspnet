                <p class="contact-phone"><a href="tel:+73412123456">+7 (3412) 12-34-56</a></p>
                <p><a href="mailto:info@remontpro.ru" class="contact-email">info@remontpro.ru</a></p>
            </div>
            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
