@model remont_kvartir.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Главная";
}

<!-- Слайдер -->
<section class="hero-slider">
    <div class="slide active" style="background-image: linear-gradient(rgba(31, 35, 40, 0.7), rgba(31, 35, 40, 0.7)), url('/images/1slide.jpg');">
        <div class="container slide-content">
            <h1>Ремонт квартир и коттеджей под ключ</h1>
            <p>Фиксированная смета. Свои мастера. Гарантия по договору.</p>
            <a href="#request" class="btn-primary">Оставить заявку</a>
        </div>
    </div>
    <div class="slide" style="background-image: linear-gradient(rgba(31, 35, 40, 0.7), rgba(31, 35, 40, 0.7)), url('/images/2slide.jpg');">
        <div class="container slide-content">
            <h1>Скидка 15% на дизайн-проект</h1>
            <p>При заказе капитального ремонта до конца месяца.</p>
            <a href="/Promotions" class="btn-primary">Узнать подробнее</a>
        </div>
    </div>
    <div class="slide" style="background-image: linear-gradient(rgba(31, 35, 40, 0.7), rgba(31, 35, 40, 0.7)), url('/images/3slide.jpg');">
        <div class="container slide-content">
            <h1>Более 500 сданных объектов</h1>
            <p>Посмотрите наши работы и оцените качество.</p>
            <a href="/Portfolio" class="btn-primary">Смотреть портфолио</a>
        </div>
    </div>
    <div class="slider-dots">
        <span class="dot active" onclick="currentSlide(0)"></span>
        <span class="dot" onclick="currentSlide(1)"></span>
        <span class="dot" onclick="currentSlide(2)"></span>
    </div>
</section>

<!-- О компании -->
<section class="section-padding">
    <div class="container flex-row">
        <div class="flex-col">
            <h2 class="section-title-left">О компании</h2>
            <p class="text-muted mb-15">«РемонтПро» — молодая команда профессионалов, которая начала свою работу в 2026 году. Мы собрали лучших инженеров и мастеров, чтобы полностью изменить подход к ремонту.</p>
            <p class="text-muted mb-30">Никаких скрытых доплат и затянутых сроков. Мы работаем строго по фиксированной смете, используем современные материалы и даем гарантию 3 года на все виды работ.</p>
            <a href="/Home/About" class="link-arrow">
                Подробнее о нас
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
        <div class="about-image-wrapper">
            <img src="/images/about.jpg" alt="О компании РемонтПро" class="about-image"
                 onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg, #e5e5e5 0%, #c97b3f 100%)'; this.parentElement.innerHTML='<div style=\'display:flex; height:100%; align-items:center; justify-content:center; color:white; font-size:24px; font-weight:600; letter-spacing:2px; opacity:0.8;\'>РЕМОНТПРО</div>';">
        </div>
    </div>
</section>

<!-- Услуги -->
<section class="section-padding bg-light border-y">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Наши услуги</h2>
            <a href="/Services" class="link-arrow">
                Смотреть все
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>

        <div class="grid-3">
            @if (!Model.LatestServices.Any())
            {
                <p class="text-muted" style="grid-column: 1 / -1; text-align: center; padding: 40px 0;">
                    Услуги пока не добавлены.
                </p>
            }
            else
            {
                @foreach (var service in Model.LatestServices)
                {
                    <div class="card service-card" style="display: flex; flex-direction: column;">

                       
                        <div style="margin-bottom: 15px; display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: var(--color-accent);">
                            <span>@(string.IsNullOrEmpty(service.Category) ? "Услуга" : service.Category)</span>
                        </div>

                        <h3 class="card-title">@service.Title</h3>
                        <p class="text-muted mb-20" style="flex-grow: 1;">@service.ShortDescription</p>

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; border-top: 1px solid var(--color-border); padding-top: 15px;">
                            @if (!string.IsNullOrEmpty(service.Price))
                            {
                                <span class="price-text">@service.Price</span>
                            }
                            else
                            {
                                <span></span>
                            }
                            <a asp-controller="Services" asp-action="Details" asp-route-id="@service.Id" class="btn-card">Подробнее</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Акции -->
<section class="section-padding">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Текущие акции</h2>
            <a href="/Promotions" class="link-arrow">Все акции</a>
        </div>
        <div class="flex-row gap-20">
            <div class="card promo-card" style="display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                    <span class="badge">-15%</span>
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="5" x2="5" y2="19"></line>
                        <circle cx="6.5" cy="6.5" r="2.5"></circle>
                        <circle cx="17.5" cy="17.5" r="2.5"></circle>
                    </svg>
                </div>
                <h3 class="card-title">Скидка на дизайн-проект</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">При заказе капитального ремонта под ключ до конца месяца.</p>
                <a href="/Promotions" class="btn-card" style="display: inline-block; text-align: center; margin-top: 10px;">Узнать подробнее</a>
            </div>
            <div class="card promo-card" style="display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                    <span class="badge">Подарок</span>
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                </div>
                <h3 class="card-title">Уборка после ремонта</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">Бесплатная профессиональная уборка при заказе от 50 м².</p>
                <a href="/Promotions" class="btn-card" style="display: inline-block; text-align: center; margin-top: 10px;">Узнать подробнее</a>
            </div>
        </div>
    </div>
</section>

<!-- Отзывы -->
<section class="section-padding bg-gray border-y">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Отзывы клиентов</h2>
            <a href="/Reviews" class="link-arrow">
                Читать все
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>

        <div class="grid-3">
            @if (Model.LatestReviews != null && Model.LatestReviews.Any())
            {
                foreach (var review in Model.LatestReviews)
                {
                    <div class="card review-card">
                        <div class="stars">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <span>★</span>
                            }
                            @for (int i = review.Rating; i < 5; i++)
                            {
                                <span style="color: #ccc;">★</span>
                            }
                        </div>
                        <p class="review-text">"@review.Text"</p>
                        <div class="review-author">@review.AuthorName</div>
                        <div class="review-meta">@review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted" style="grid-column: 1 / -1; text-align: center;">Пока нет отзывов.</p>
            }
        </div>
    </div>
</section>

<!-- Форма заявки -->
<section id="request" class="cta-section">
    <div class="container cta-container">
        <h2 class="cta-title">Оставьте заявку на ремонт</h2>
        <p class="cta-subtitle">Приедем на замер, составим точную смету и проконсультируем бесплатно</p>

        <!-- Блок для вывода сообщений -->
        <div id="formMessage" style="display: none; padding: 15px; border-radius: 6px; margin-bottom: 20px; text-align: center; font-weight: 500;"></div>

        <form id="repairForm" class="custom-form">
            @Html.AntiForgeryToken()

            <div>
                <input type="text" name="Name" id="Name" placeholder="Ваше имя" required class="custom-input" />
            </div>
            <div>
                <input type="tel" name="Phone" id="Phone" placeholder="Ваш телефон" required class="custom-input" />
            </div>

            <div class="select-wrapper" style="grid-column: 1 / -1;">
                <select name="RepairType" id="RepairType" class="custom-select" required>
                    <option value="" disabled selected hidden>Тип ремонта</option>
                    <option value="Косметический">Косметический</option>
                    <option value="Капитальный">Капитальный</option>
                    <option value="Коттедж">Коттедж</option>
                    <option value="Дизайнерский">Дизайнерский</option>
                </select>
                <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            <button type="submit" id="submitBtn" class="btn-submit" style="grid-column: 1 / -1;">Отправить</button>
            <p class="form-policy" style="grid-column: 1 / -1;">
                Нажимая кнопку, вы соглашаетесь с <a href="#">политикой обработки персональных данных</a>
            </p>
        </form>
    </div>
</section>

<!-- Контакты -->
<section class="section-padding">
    <div class="container">
        <h2 class="section-title-center">Наши контакты</h2>
        <div class="grid-3 text-center">
            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <h3 class="contact-title">Офис компании</h3>
                <p class="text-muted">г. Ижевск,<br>ул. Советская, д. 15, офис 304</p>
            </div>
            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <h3 class="contact-title">Связаться с нами</h3>
                <p class="contact-phone"><a href="tel:+73412123456">+7 (3412) 12-34-56</a></p>
                <p><a href="mailto:info@remontpro.ru" class="contact-email">info@remontpro.ru</a></p>
            </div>
            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <h3 class="contact-title">Режим работы</h3>
                <p class="text-muted">Пн-Пт: с 9:00 до 20:00<br>Сб-Вс: по договоренности</p>
            </div>
        </div>
        <div class="text-center mt-40">
            <a href="/Contacts" class="btn-dark">Перейти на страницу контактов</a>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('repairForm');
            const messageBox = document.getElementById('formMessage');
            const submitBtn = document.getElementById('submitBtn');

            if (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const originalBtnText = submitBtn.innerText;
                    submitBtn.innerText = 'Отправка...';
                    submitBtn.disabled = true;
                    messageBox.style.display = 'none';

                    const formData = {
                        Name: document.getElementById('Name').value,
                        Phone: document.getElementById('Phone').value,
                        RepairType: document.getElementById('RepairType').value
                    };

                    const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                    try {
                        const response = await fetch('/Home/SubmitRequest', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify(formData)
                        });

                        const result = await response.json();
                        messageBox.style.display = 'block';

                        if (result.success) {
                            messageBox.style.background = 'rgba(39, 174, 96, 0.2)';
                            messageBox.style.border = '1px solid #27ae60';
                            messageBox.style.color = '#fff';
                            messageBox.innerText = result.message;
                            form.reset();
                        } else {
                            messageBox.style.background = 'rgba(231, 76, 60, 0.2)';
                            messageBox.style.border = '1px solid #e74c3c';
                            messageBox.style.color = '#fff';
                            messageBox.innerText = result.message || 'Произошла ошибка.';
                        }
                    } catch (error) {
                        messageBox.style.display = 'block';
                        messageBox.style.background = 'rgba(231, 76, 60, 0.2)';
                        messageBox.style.border = '1px solid #e74c3c';
                        messageBox.style.color = '#fff';
                        messageBox.innerText = 'Ошибка сети. Попробуйте позже.';
                    } finally {
                        submitBtn.innerText = originalBtnText;
                        submitBtn.disabled = false;
                    }
                });
            }
        });
    </script>
}