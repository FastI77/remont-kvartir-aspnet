@{
    ViewData["Title"] = "Главная";
}

<!-- Слайдер -->
<section class="hero-slider">
    <div class="slide active" style="background-image: linear-gradient(rgba(31, 35, 40, 0.7), rgba(31, 35, 40, 0.7)), url('/images/1slide.jpg');">
        <div class="container slide-content">
            <h1>Ремонт квартир и коттеджей под ключ</h1>
            <p>Фиксированная смета. Свои мастера. Гарантия по договору.</p>
            <a href="#request" class="btn-primary">Оставить заявку</a>
        </div>
    </div>
    <div class="slide" style="background-image: linear-gradient(rgba(31, 35, 40, 0.7), rgba(31, 35, 40, 0.7)), url('/images/2slide.jpg');">
        <div class="container slide-content">
            <h1>Скидка 15% на дизайн-проект</h1>
            <p>При заказе капитального ремонта до конца месяца.</p>
            <a href="/Promotions" class="btn-primary">Узнать подробнее</a>
        </div>
    </div>
    <div class="slide" style="background-image: linear-gradient(rgba(31, 35, 40, 0.7), rgba(31, 35, 40, 0.7)), url('/images/3slide.jpg');">
        <div class="container slide-content">
            <h1>Более 500 сданных объектов</h1>
            <p>Посмотрите наши работы и оцените качество.</p>
            <a href="/Portfolio" class="btn-primary">Смотреть портфолио</a>
        </div>
    </div>
    <div class="slider-dots">
        <span class="dot active" onclick="currentSlide(0)"></span>
        <span class="dot" onclick="currentSlide(1)"></span>
        <span class="dot" onclick="currentSlide(2)"></span>
    </div>
</section>

<!-- О компании -->
<section class="section-padding">
    <div class="container flex-row">
        <div class="flex-col">
            <h2 class="section-title-left">О компании</h2>
            <p class="text-muted mb-15">«РемонтПро» — молодая команда профессионалов, которая начала свою работу в 2026 году. Мы собрали лучших инженеров и мастеров, чтобы полностью изменить подход к ремонту.</p>
            <p class="text-muted mb-30">Никаких скрытых доплат и затянутых сроков. Мы работаем строго по фиксированной смете, используем современные материалы и даем гарантию 3 года на все виды работ.</p>
            <a href="/Home/About" class="link-arrow">
                Подробнее о нас
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
        <div class="about-image-wrapper">
            <img src="/images/about.jpg" alt="О компании РемонтПро" class="about-image"
                 onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg, #e5e5e5 0%, #c97b3f 100%)'; this.parentElement.innerHTML='<div style=\'display:flex; height:100%; align-items:center; justify-content:center; color:white; font-size:24px; font-weight:600; letter-spacing:2px; opacity:0.8;\'>РЕМОНТПРО</div>';">
        </div>
    </div>
</section>

<!-- Услуги -->
<section class="section-padding bg-light border-y">
    <div class="container">
        <h2 class="section-title-center">Наши услуги</h2>
        <div class="grid-3">
            <div class="card service-card" style="display: flex; flex-direction: column;">
                <div style="margin-bottom: 20px;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                        <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                        <path d="M2 2l7.586 7.586"></path>
                        <circle cx="11" cy="11" r="2"></circle>
                    </svg>
                </div>
                <h3 class="card-title">Косметический ремонт</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">Обновление интерьера без перепланировки: шпаклевка, покраска, обои, замена полов.</p>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                    <span class="price-text">от 5 000 ₽/м²</span>
                    <a href="/Services" class="btn-card">Подробнее</a>
                </div>
            </div>
            <div class="card service-card" style="display: flex; flex-direction: column;">
                <div style="margin-bottom: 20px;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </div>
                <h3 class="card-title">Капитальный ремонт</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">Полная перестройка пространства, замена инженерных сетей, выравнивание стен и потолков.</p>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                    <span class="price-text">от 12 000 ₽/м²</span>
                    <a href="/Services" class="btn-card">Подробнее</a>
                </div>
            </div>
            <div class="card service-card" style="display: flex; flex-direction: column;">
                <div style="margin-bottom: 20px;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                </div>
                <h3 class="card-title">Ремонт коттеджей</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">Отделка загородных домов любой сложности. Внутренние и фасадные работы.</p>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                    <span class="price-text">Расчет по проекту</span>
                    <a href="/Services" class="btn-card">Подробнее</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Акции -->
<section class="section-padding">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Текущие акции</h2>
            <a href="/Promotions" class="link-arrow">Все акции</a>
        </div>
        <div class="flex-row gap-20">
            <div class="card promo-card" style="display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                    <span class="badge">-15%</span>
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="5" x2="5" y2="19"></line>
                        <circle cx="6.5" cy="6.5" r="2.5"></circle>
                        <circle cx="17.5" cy="17.5" r="2.5"></circle>
                    </svg>
                </div>
                <h3 class="card-title">Скидка на дизайн-проект</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">При заказе капитального ремонта под ключ до конца месяца.</p>
                <a href="/Promotions" class="btn-card" style="display: inline-block; text-align: center; margin-top: 10px;">Узнать подробнее</a>
            </div>
            <div class="card promo-card" style="display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                    <span class="badge">Подарок</span>
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                </div>
                <h3 class="card-title">Уборка после ремонта</h3>
                <p class="text-muted mb-20" style="flex-grow: 1;">Бесплатная профессиональная уборка при заказе от 50 м².</p>
                <a href="/Promotions" class="btn-card" style="display: inline-block; text-align: center; margin-top: 10px;">Узнать подробнее</a>
            </div>
        </div>
    </div>
</section>

<!-- Отзывы -->
<section class="section-padding bg-gray border-y">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Отзывы клиентов</h2>
            <a href="/Reviews" class="link-arrow">
                Читать все
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
        <div class="grid-3">
            <div class="card review-card">
                <div class="stars">★★★★★</div>
                <p class="review-text">"Делали ремонт двушки. Смета не менялась ни разу, уложились в срок. Мастера аккуратные, мусор выносили каждый день."</p>
                <div class="review-author">Анна Смирнова</div>
                <div class="review-meta">Ремонт квартиры, 2 мес.</div>
            </div>
            <div class="card review-card">
                <div class="stars">★★★★★</div>
                <p class="review-text">"Отличная работа. Заказывали ремонт коттеджа. Понравился подход инженера — сразу указал на ошибки в чужом проекте."</p>
                <div class="review-author">Дмитрий Волков</div>
                <div class="review-meta">Ремонт коттеджа, 4 мес.</div>
            </div>
            <div class="card review-card">
                <div class="stars">★★★★☆</div>
                <p class="review-text">"Все хорошо, качеством довольны. Единственный минус — пришлось немного подождать плитку, но менеджер держал в курсе."</p>
                <div class="review-author">Елена К.</div>
                <div class="review-meta">Косметический ремонт</div>
            </div>
        </div>
    </div>
</section>

<!-- Форма заявки -->
<section id="request" class="cta-section">
    <div class="container cta-container">
        <h2 class="cta-title">Оставьте заявку на ремонт</h2>
        <p class="cta-subtitle">Приедем на замер, составим точную смету и проконсультируем бесплатно</p>

        <form action="#" method="POST" class="custom-form">
            <input type="text" placeholder="Ваше имя" required class="custom-input">
            <input type="tel" placeholder="Ваш телефон" required class="custom-input">

            <div class="select-wrapper">
                <select class="custom-select" required>
                    <option value="" disabled selected hidden>Тип ремонта</option>
                    <option value="cosmetic">Косметический</option>
                    <option value="capital">Капитальный</option>
                    <option value="cottage">Коттедж</option>
                    <option value="design">Дизайнерский</option>
                </select>
                <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            <button type="submit" class="btn-submit">Отправить</button>
            <p class="form-policy">
                Нажимая кнопку, вы соглашаетесь с <a href="#">политикой обработки персональных данных</a>
            </p>
        </form>
    </div>
</section>

