@model remont_kvartir.Models.Service
@{
    ViewData["Title"] = Model.Title;
}

<section class="section-padding" style="background: #fff;">
    <div class="container" style="max-width: 1100px;">

        <a asp-action="Index" class="link-arrow" style="margin-bottom: 40px; display: inline-flex; color: #888;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg); margin-right: 6px; margin-left: 0;">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            Назад ко всем услугам
        </a>

        <div class="service-layout-grid">

            <div>
                <span style="display: block; color: var(--color-accent); font-weight: 600; letter-spacing: 1px; text-transform: uppercase; font-size: 13px; margin-bottom: 15px;">
                    @(string.IsNullOrEmpty(Model.Category) ? "Услуга" : Model.Category)
                </span>

                <h1 style="font-size: 46px; color: var(--color-dark); line-height: 1.15; margin-bottom: 30px; font-weight: 800;">
                    @Model.Title
                </h1>

                <div style="font-size: 18px; color: #555; line-height: 1.6; margin-bottom: 40px;">
                    @Model.ShortDescription
                </div>

                <hr style="border: none; border-top: 1px solid var(--color-border); margin-bottom: 40px;" />

                <h3 style="font-size: 24px; margin-bottom: 25px; color: var(--color-dark); font-weight: 700;">
                    Подробнее об услуге
                </h3>

                <div style="line-height: 1.8; font-size: 16px; color: #444; white-space: pre-line;">
                    @Model.FullDescription
                </div>
            </div>

            <div>
                <div class="service-sidebar">
                    <div style="margin-bottom: 30px;">
                        <p style="font-size: 14px; color: #888; margin-bottom: 10px;">Стоимость</p>

                        @if (!string.IsNullOrEmpty(Model.Price))
                        {
                            <div style="font-size: 36px; font-weight: 800; line-height: 1.1; color: var(--color-dark); margin-bottom: 15px;">
                                @Model.Price
                            </div>
                        }
                        else
                        {
                            <div style="font-size: 28px; font-weight: 800; color: var(--color-dark); margin-bottom: 15px;">По запросу</div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Duration))
                        {
                            <div style="display: flex; align-items: center; gap: 8px; color: #444; font-size: 15px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                <span><strong>Срок:</strong> @Model.Duration</span>
                            </div>
                        }
                    </div>

                    <p style="font-size: 15px; color: #666; margin-bottom: 30px; line-height: 1.6;">
                        Точная стоимость зависит от состояния помещения и выбранных материалов. Оставьте заявку для бесплатного расчета сметы.
                    </p>

                    <a href="/#request" class="btn-primary" style="display: block; width: 100%; text-align: center; padding: 16px; font-size: 16px; border-radius: 6px; box-sizing: border-box; box-shadow: 0 4px 15px rgba(201, 123, 63, 0.3); margin-bottom: 20px;">
                        Оставить заявку
                    </a>

                    <div style="text-align: center; margin-bottom: 30px;">
                        <a href="tel:+73412123456" style="font-weight: 700; color: var(--color-dark); font-size: 18px; text-decoration: none;">+7 (3412) 12-34-56</a>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 15px;">
                        <div style="display: flex; align-items: flex-start; gap: 12px; font-size: 14px; color: #444;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                            <span>Гарантия по договору 3 года на все работы</span>
                        </div>
                        <div style="display: flex; align-items: flex-start; gap: 12px; font-size: 14px; color: #444;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Фиксированная смета, без скрытых доплат</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .service-layout-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 60px;
        align-items: start;
    }

    .service-sidebar {
        position: sticky;
        top: 100px;
    }

    @@media (max-width: 900px) {
        .service-layout-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .service-sidebar {
            position: relative;
            top: 0;
        }

        h1 {
            font-size: 36px !important;
        }
    }
</style>