@model remont_kvartir.Models.Service
@{
    ViewData["Title"] = Model.Title;
}

<section class="section-padding">
    <div class="container" style="max-width: 800px;">
        <a asp-action="Index" class="link-arrow" style="margin-bottom: 20px; display: inline-flex;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg); margin-right: 6px; margin-left: 0;">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            Назад ко всем услугам
        </a>

        <div style="margin-bottom: 20px;">
            <span class="badge">@(string.IsNullOrEmpty(Model.Category) ? "Услуга" : Model.Category)</span>
            @if (!string.IsNullOrEmpty(Model.Duration))
            {
                <span style="margin-left: 15px; font-size: 14px; color: #555;">⏱ Длительность: @Model.Duration</span>
            }
        </div>

        <h1 class="section-title-left">@Model.Title</h1>

        @if (!string.IsNullOrEmpty(Model.Price))
        {
            <p class="price-text" style="font-size: 24px; margin-bottom: 30px;">@Model.Price</p>
        }

        <div class="card" style="padding: 30px; margin-bottom: 40px;">
            <h3 style="margin-bottom: 15px;">Описание услуги</h3>
            <p class="text-muted" style="white-space: pre-line; line-height: 1.8;">@Model.FullDescription</p>
        </div>

        <div style="text-align: center;">
            <h3 style="margin-bottom: 15px;">Готовы обсудить ваш проект?</h3>
            <a href="/#request" class="btn-primary">Оставить заявку на ремонт</a>
        </div>
    </div>
</section>