@model IEnumerable<remont_kvartir.Models.Review>
@{
    ViewData["Title"] = "Отзывы";
}
@if (TempData["Error"] != null)
{
    <div class="card" style="background:#fce4e4; border-color:#f5c6cb; margin-bottom:20px; color: #721c24;">
        @TempData["Error"]
    </div>
}

<section class="section-padding">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="card" style="background:#e6f7e6; border-color:#79c879; margin-bottom:20px;">
                @TempData["Success"]
            </div>
        }

        <div class="section-header">
            <h2 class="section-title">Отзывы клиентов</h2>
            <a asp-action="Create" class="btn-primary">Оставить отзыв</a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center" style="padding: 40px 0;">
                <p class="text-muted">Пока нет отзывов.</p>
            </div>
        }
        else
        {
            <div class="grid-3">
                @foreach (var review in Model)
                {
                    <div class="card review-card">
                        <div class="stars" style="display: flex; gap: 4px; color: #f5b041; margin-bottom: 15px;">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            }
                            @for (int i = review.Rating; i < 5; i++)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="#e5e5e5" stroke="none">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            }
                        </div>
                        <p class="review-text">"@review.Text"</p>
                        @if (!string.IsNullOrEmpty(review.ImageUrl))
                        {
                            <img src="@review.ImageUrl" alt="Фото отзыва" style="width: 100%; max-height: 200px; object-fit: cover; border-radius: 6px; margin-bottom: 15px;" />
                        }
                        <div class="review-author">@review.AuthorName</div>
                        <div class="review-meta">@review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                    </div>
                }
            </div>
        }
    </div>
</section>