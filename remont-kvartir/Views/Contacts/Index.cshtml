@{
    ViewData["Title"] = "Контакты";
}

<section class="section-padding">
    <div class="container">
        <h2 class="section-title-center">Наши контакты</h2>

        <div class="grid-3 text-center" style="margin-bottom: 50px;">
            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <h3 class="contact-title">Офис компании</h3>
                <p class="text-muted">г. Ижевск,<br>ул. Советская, д. 15, офис 304</p>
            </div>

            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <h3 class="contact-title">Связаться с нами</h3>
                <p class="contact-phone"><a href="tel:+73412123456">+7 (3412) 12-34-56</a></p>
                <p><a href="mailto:info@remontpro.ru" class="contact-email">info@remontpro.ru</a></p>
            </div>

            <div class="card contact-card">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c97b3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <h3 class="contact-title">Режим работы</h3>
                <p class="text-muted">Пн-Пт: с 9:00 до 20:00<br>Сб-Вс: по договоренности</p>
            </div>
        </div>

        <div class="card" style="padding: 20px; margin-bottom: 40px;">
            <h3 class="section-title-left" style="margin-bottom: 20px;">Мы на карте</h3>

            <div id="yandex-map" style="width: 100%; height: 400px; border-radius: 8px; background-color: #eee; display: flex; align-items: center; justify-content: center;">
            </div>
        </div>

        <div class="card" style="max-width: 700px; margin: 0 auto; padding: 40px;">
            <h3 class="section-title-center" style="margin-bottom: 30px; font-size: 24px;">Остались вопросы?</h3>
            <p class="text-muted text-center" style="margin-bottom: 30px;">Оставьте сообщение, и мы свяжемся с вами в ближайшее время.</p>

            <div id="contactMessage" style="display: none; padding: 15px; border-radius: 6px; margin-bottom: 20px; text-align: center; font-weight: 500;"></div>

            <form id="contactForm" method="post">
                @Html.AntiForgeryToken()
                <div class="custom-form">
                    <input type="text" id="Name" name="Name" placeholder="Ваше имя" required class="custom-input" minlength="2" maxlength="50" pattern="^[А-Яа-яЁёA-Za-z\s\-]+$" title="Имя должно содержать только буквы" />
                    <input type="email" id="Email" name="Email" placeholder="Ваш Email" required class="custom-input" maxlength="100" />
                    <textarea id="Message" name="Message" placeholder="Ваше сообщение..." required class="custom-input" minlength="10" maxlength="200" rows="5" style="grid-column: 1 / -1; resize: vertical;"></textarea>
                    <button type="submit" id="contactSubmitBtn" class="btn-submit" style="grid-column: 1 / -1;">Отправить сообщение</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://api-maps.yandex.ru/2.1/?apikey=6aa9d687-ebed-4e84-a801-3f1990647388&lang=ru_RU" type="text/javascript"></script>
    <script type="text/javascript">
        ymaps.ready(init);
        function init(){
            var myMap = new ymaps.Map("yandex-map", {
                center: [56.852, 53.204],
                zoom: 16
            });
            var myPlacemark = new ymaps.Placemark([56.852, 53.204], {
                balloonContent: 'РемонтПро<br>ул. Советская, д. 15'
            }, {
                preset: 'islands#orangeIcon'
            });
            myMap.geoObjects.add(myPlacemark);
        }
 
        const nameInput = document.getElementById('Name');
        if (nameInput) {
            nameInput.addEventListener('input', function () {
                this.value = this.value.replace(/[0-9]/g, '');
            });
        }

            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('contactForm');
                const messageBox = document.getElementById('contactMessage');
                const submitBtn = document.getElementById('contactSubmitBtn');

                if (form) {
                    form.addEventListener('submit', function (event) {
                        event.preventDefault()

                        const originalBtnText = submitBtn.innerText;
                        submitBtn.innerText = 'Отправка...';
                        submitBtn.disabled = true;
                        messageBox.style.display = 'none';

                        setTimeout(function () {
                            messageBox.style.display = 'block';
                            messageBox.style.background = '#e6f7e6';
                            messageBox.style.border = '1px solid #79c879';
                            messageBox.style.color = '#2c7a2c';
                            messageBox.innerText = 'Спасибо! Ваше сообщение отправлено. Мы свяжемся с вами.';

                            form.reset();

                            submitBtn.innerText = originalBtnText;
                            submitBtn.disabled = false;

                            setTimeout(() => {
                                messageBox.style.display = 'none';
                            }, 5000);
                        }, 1000);
                    });
                }
            });
    </script>
}