@model remont_kvartir.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}

<section class="section-padding">
    <div class="container" style="max-width: 500px;">
        <h2 class="section-title-left">Смена пароля</h2>

        <form asp-action="ChangePassword" method="post" class="card">
            <div asp-validation-summary="ModelOnly" style="color:#c00; margin-bottom:15px;"></div>

            <div style="margin-bottom:15px;">
                <label asp-for="CurrentPassword" style="display:block; margin-bottom:6px;"></label>
                <input asp-for="CurrentPassword" class="custom-input" style="color:#1f2328;" />
                <span asp-validation-for="CurrentPassword" style="color:#c00; font-size:13px;"></span>
            </div>

            <div style="margin-bottom:15px;">
                <label asp-for="NewPassword" style="display:block; margin-bottom:6px;"></label>
                <input asp-for="NewPassword" class="custom-input" style="color:#1f2328;" />
                <span asp-validation-for="NewPassword" style="color:#c00; font-size:13px;"></span>
            </div>

            <div style="margin-bottom:15px;">
                <label asp-for="ConfirmPassword" style="display:block; margin-bottom:6px;"></label>
                <input asp-for="ConfirmPassword" class="custom-input" style="color:#1f2328;" />
                <span asp-validation-for="ConfirmPassword" style="color:#c00; font-size:13px;"></span>
            </div>

            <button type="submit" class="btn-submit" style="width:100%;">Сменить пароль</button>
        </form>

        <p style="margin-top:20px;"><a asp-action="Index" class="link-arrow">← Назад в кабинет</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}