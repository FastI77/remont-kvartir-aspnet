@model remont_kvartir.ViewModels.RepairRequestViewModel
@{
    ViewData["Title"] = "Новая заявка";
}

<section class="section-padding">
    <div class="container" style="max-width: 600px;">
        <h2 class="section-title-left">Оставить заявку на ремонт</h2>

        <form asp-action="CreateRequest" method="post" class="card">
            <div asp-validation-summary="ModelOnly" style="color:#c00; margin-bottom:15px;"></div>

            <div style="margin-bottom:15px;">
                <label asp-for="RepairType" style="display:block; margin-bottom:6px;"></label>
                <select asp-for="RepairType" class="custom-select" style="color:#1f2328;">
                    <option value="">-- Выберите тип --</option>
                    <option value="Косметический">Косметический</option>
                    <option value="Капитальный">Капитальный</option>
                    <option value="Коттедж">Коттедж</option>
                    <option value="Дизайнерский">Дизайнерский</option>
                </select>
                <span asp-validation-for="RepairType" style="color:#c00; font-size:13px;"></span>
            </div>

            <div style="margin-bottom:15px;">
                <label asp-for="Description" style="display:block; margin-bottom:6px;"></label>
                <textarea asp-for="Description" class="custom-input" rows="5" style="color:#1f2328; resize:vertical;"></textarea>
                <span asp-validation-for="Description" style="color:#c00; font-size:13px;"></span>
            </div>

            <div style="margin-bottom:15px;">
                <label asp-for="Address" style="display:block; margin-bottom:6px;"></label>
                <input asp-for="Address" class="custom-input" style="color:#1f2328;" />
                <span asp-validation-for="Address" style="color:#c00; font-size:13px;"></span>
            </div>

            <div style="margin-bottom:15px;">
                <label asp-for="Area" style="display:block; margin-bottom:6px;"></label>
                <input asp-for="Area" type="number" step="0.1" class="custom-input" style="color:#1f2328;" />
                <span asp-validation-for="Area" style="color:#c00; font-size:13px;"></span>
            </div>

            <button type="submit" class="btn-submit" style="width:100%;">Отправить заявку</button>
        </form>

        <p style="margin-top:20px;"><a asp-action="Index" class="link-arrow">← Назад в кабинет</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}