@model remont_kvartir.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<section class="section-padding">
    <div class="container" style="max-width: 500px;">
        <h2 class="section-title-center" style="margin-bottom: 30px;">Регистрация</h2>

        <div class="auth-form-wrapper">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" style="color:#c00; margin-bottom:15px; font-size: 14px;"></div>

                <div class="form-group">
                    <label asp-for="FullName">ФИО</label>
                    <input asp-for="FullName" class="custom-input" placeholder="Иванов Иван Иванович" />
                    <span asp-validation-for="FullName" style="color:#c00; font-size:13px;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="custom-input" placeholder="example@mail.ru" />
                    <span asp-validation-for="Email" style="color:#c00; font-size:13px;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Phone">Телефон</label>
                    <input asp-for="Phone" class="custom-input" placeholder="+7 (999) 123-45-67" />
                    <span asp-validation-for="Phone" style="color:#c00; font-size:13px;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Пароль</label>
                    <input asp-for="Password" class="custom-input" placeholder="Минимум 6 символов" />
                    <span asp-validation-for="Password" style="color:#c00; font-size:13px;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Подтверждение пароля</label>
                    <input asp-for="ConfirmPassword" class="custom-input" placeholder="Повторите пароль" />
                    <span asp-validation-for="ConfirmPassword" style="color:#c00; font-size:13px;"></span>
                </div>

                <button type="submit" class="btn-submit" style="width:100%;">Зарегистрироваться</button>

                <p style="text-align:center; margin-top:25px; font-size: 14px;">
                    Уже есть аккаунт? <a asp-action="Login" style="font-weight: 600;">Войти</a>
                </p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}