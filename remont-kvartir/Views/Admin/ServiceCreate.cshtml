@model remont_kvartir.Models.Service
@{
    ViewData["Title"] = "Добавить услугу";
}

<section class="section-padding">
    <div class="container" style="max-width: 600px;">
        <h2 class="section-title-left">Новая услуга</h2>
        <form asp-action="ServiceCreate" method="post" class="card">
            <div asp-validation-summary="ModelOnly" style="color: red; margin-bottom: 15px;"></div>

            <div class="form-group">
                <label asp-for="Title">Название</label>
                <input asp-for="Title" class="custom-input" required />
            </div>
            <div class="form-group">
                <label asp-for="ShortDescription">Краткое описание</label>
                <input asp-for="ShortDescription" class="custom-input" required />
            </div>
            <div class="form-group">
                <label asp-for="FullDescription">Полное описание</label>
                <textarea asp-for="FullDescription" class="custom-input" rows="4" required></textarea>
            </div>
            <div class="form-group">
                <label asp-for="Price">Цена</label>
                <input asp-for="Price" class="custom-input" />
            </div>
            <div class="form-group">
                <label asp-for="Category">Категория (например, Квартиры)</label>
                <input asp-for="Category" class="custom-input" />
            </div>
            <div class="form-group">
                <label asp-for="Duration">Срок (например, от 2 недель)</label>
                <input asp-for="Duration" class="custom-input" />
            </div>

            <button type="submit" class="btn-submit" style="width: 100%;">Сохранить</button>
            <a asp-action="Services" style="display: block; text-align: center; margin-top: 15px;">Отмена</a>
        </form>
    </div>
</section>