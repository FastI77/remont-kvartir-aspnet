@model IEnumerable<remont_kvartir.Models.PortfolioItem>
@{
    ViewData["Title"] = "Портфолио";
}

<section class="section-padding">
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h2 class="section-title-left" style="margin: 0;">Управление портфолио</h2>
            <div>
                <a asp-action="PortfolioCreate" class="btn-primary" style="padding: 10px 20px; font-size: 14px;">+ Добавить работу</a>
                <a asp-action="Index" class="link-arrow" style="margin-left: 20px;">← Назад</a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted">Портфолио пока пустое.</p>
        }
        else
        {
            <div class="grid-3">
                @foreach (var item in Model)
                {
                    <div class="card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" style="width: 100%; height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="width: 100%; height: 200px; background: #e5e5e5; display: flex; align-items: center; justify-content: center; color: #888;">Нет фото</div>
                        }
                        <div style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column;">
                            <h4 style="margin-bottom: 10px;">@item.Title</h4>
                            <p class="text-muted" style="font-size: 14px; margin-bottom: 15px; flex-grow: 1;">@item.Description</p>

                            <div style="display: flex; gap: 15px; align-items: center;">
                                <a asp-action="PortfolioEdit" asp-route-id="@item.Id" class="link-arrow">Редактировать</a>
                                <form asp-action="PortfolioDelete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Удалить работу?');" style="margin: 0;">
                                    <button type="submit" style="background: none; border: none; color: #e74c3c; cursor: pointer; padding: 0; font-weight: 600; font-size: 15px;">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>