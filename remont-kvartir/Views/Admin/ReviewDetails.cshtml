@model remont_kvartir.Models.Review
@{
    ViewData["Title"] = "Просмотр отзыва";
}

<section class="section-padding">
    <div class="container" style="max-width: 800px;">
        <a asp-action="Reviews" class="link-arrow" style="margin-bottom: 30px; display: inline-flex;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg); margin-right: 6px; margin-left: 0;">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            Назад ко всем отзывам
        </a>

        @if (TempData["Success"] != null)
        {
            <div style="background: #e6f7e6; border: 1px solid #79c879; color: #2c7a2c; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
                @TempData["Success"]
            </div>
        }

        <div class="card" style="padding: 40px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div class="stars" style="display: flex; gap: 4px;">
                    @for (int i = 0; i < Model.Rating; i++)
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="#f5b041" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    }
                </div>
                @if (Model.IsApproved)
                {
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Опубликован
                    </span>
                }
                else
                {
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; background: #fff8e1; color: #f57f17; border: 1px solid #ffecb3;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        На модерации
                    </span>
                }
            </div>

            <h2 style="font-size: 24px; color: var(--color-dark); margin-bottom: 10px;">@Model.AuthorName</h2>
            <p class="text-muted" style="margin-bottom: 30px;">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>

            <p style="font-size: 18px; line-height: 1.8; color: #444; margin-bottom: 30px; white-space: pre-line;">
                "@Model.Text"
            </p>

            @if (Model.Gallery != null && Model.Gallery.Any())
            {
                <h3 style="font-size: 18px; margin-bottom: 15px;">Фотографии</h3>
                <div class="portfolio-main-slider" style="margin-bottom: 20px;">
                    <div class="main-slider-track">
                        @foreach (var img in Model.Gallery)
                        {
                            <div class="main-slide">
                                <img src="@img.ImageUrl" alt="Фото отзыва" />
                            </div>
                        }
                    </div>
                    @if (Model.Gallery.Count > 1)
                    {
                        <button class="slider-btn prev-btn" onclick="moveMainSlide(-1)">&#10094;</button>
                        <button class="slider-btn next-btn" onclick="moveMainSlide(1)">&#10095;</button>
                    }
                </div>
            }

            <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--color-border); display: flex; gap: 15px;">
                @if (!Model.IsApproved)
                {
                    <form asp-action="ApproveReview" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("ReviewDetails", new { id = Model.Id })" />
                        <button type="submit" style="background: transparent; color: #2e7d32; border: 1px solid #c8e6c9; padding: 10px 20px; border-radius: 6px; font-size: 15px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: background 0.2s;"
                                onmouseover="this.style.background='#e8f5e9'"
                                onmouseout="this.style.background='transparent'">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Одобрить отзыв
                        </button>
                    </form>
                }
                <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Удалить отзыв?');" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" style="background: transparent; color: #c0392b; border: 1px solid #f5c6cb; padding: 10px 20px; border-radius: 6px; font-size: 15px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: background 0.2s;"
                            onmouseover="this.style.background='#fce4e4'"
                            onmouseout="this.style.background='transparent'">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        Удалить отзыв
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        let currentMainSlide = 0;
        function updateSliderAndThumbs(index) {
            const track = document.querySelector('.main-slider-track');
            const slides = document.querySelectorAll('.main-slide');
            if (!track || slides.length === 0) return;

            if (index >= slides.length) currentMainSlide = 0;
            else if (index < 0) currentMainSlide = slides.length - 1;
            else currentMainSlide = index;

            track.style.transform = `translateX(-${currentMainSlide * 100}%)`;
        }
        function moveMainSlide(direction) { updateSliderAndThumbs(currentMainSlide + direction); }
    </script>
}