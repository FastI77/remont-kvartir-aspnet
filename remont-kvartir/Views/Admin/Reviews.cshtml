@model IEnumerable<remont_kvartir.Models.Review>
@{
    ViewData["Title"] = "Модерация отзывов";
}

<section class="section-padding">
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h2 class="section-title-left" style="margin: 0;">Модерация отзывов</h2>
            <a asp-action="Index" class="link-arrow">← Назад в панель</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div style="background: #e6f7e6; border: 1px solid #79c879; color: #2c7a2c; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
                @TempData["Success"]
            </div>
        }

        <div class="grid-3">
            @if (!Model.Any())
            {
                <p class="text-muted">Отзывов пока нет.</p>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="card review-card">
                        <div class="stars" style="display: flex; gap: 4px; margin-bottom: 15px;">
                            @for (int i = 0; i < item.Rating; i++)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="#f5b041" stroke="none">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            }
                            @for (int i = item.Rating; i < 5; i++)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="#e5e5e5" stroke="none">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            }
                        </div>
                        <p class="review-text">"@item.Text"</p>
                        @if (item.Gallery != null && item.Gallery.Any())
                        {
                            <div style="display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 15px;">
                                @foreach (var img in item.Gallery)
                                {
                                    <img src="@img.ImageUrl" alt="Фото отзыва"
                                         style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px; cursor: pointer;"
                                         onclick="openAdminImage('@img.ImageUrl')" />
                                }
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="Фото отзыва"
                                 style="width: 100%; max-height: 200px; object-fit: cover; border-radius: 6px; margin-bottom: 15px; cursor: pointer;"
                                 onclick="openAdminImage('@item.ImageUrl')" />
                        }
                        <div class="review-author">@item.AuthorName</div>
                        <div class="review-meta">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>

                        <div style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                                @if (item.IsApproved)
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        Опубликован
                                    </span>
                                }
                                else
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #fff8e1; color: #f57f17; border: 1px solid #ffecb3;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                        На модерации
                                    </span>
                                }
                                <a asp-action="ReviewDetails" asp-route-id="@item.Id" style="font-weight: 600; color: var(--color-accent); text-decoration: none; font-size: 16px;">
                                    Подробнее
                                </a>
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    @if (!item.IsApproved)
                                    {
                                        <form asp-action="ApproveReview" method="post" style="margin: 0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" style="background: none; border: none; color: #27ae60; font-weight: 600; cursor: pointer; padding: 5px 0; font-size: 14px; display: flex; align-items: center; gap: 5px;">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                Одобрить
                                            </button>
                                        </form>
                                    }
                                </div>
                                <div>
                                    <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Удалить отзыв?');" style="margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" style="background: none; border: none; color: #e74c3c; font-weight: 600; cursor: pointer; padding: 5px 0; font-size: 14px; display: flex; align-items: center; gap: 5px;">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            Удалить
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<div id="adminImageModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 9999; justify-content: center; align-items: center;">
    <button onclick="closeAdminImage()" style="position: absolute; top: 20px; right: 30px; background: transparent; border: none; color: white; font-size: 40px; cursor: pointer; z-index: 10000;">&times;</button>
    <img id="adminModalImage" src="" style="max-width: 90%; max-height: 90vh; border-radius: 4px; box-shadow: 0 0 30px rgba(0,0,0,0.5); object-fit: contain;" />
</div>

<script>
    function openAdminImage(url) {
        document.getElementById('adminModalImage').src = url;
        document.getElementById('adminImageModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeAdminImage() {
        document.getElementById('adminImageModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }

    document.getElementById('adminImageModal').addEventListener('click', function (e) {
        if (e.target === this) closeAdminImage();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAdminImage();
    });
</script>