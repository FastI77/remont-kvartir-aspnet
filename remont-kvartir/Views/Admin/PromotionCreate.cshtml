@model remont_kvartir.Models.Promotion
@{
    ViewData["Title"] = "Добавить акцию";
}

<section class="section-padding">
    <div class="container" style="max-width: 600px;">
        <h2 class="section-title-left">Новая акция</h2>
        <form asp-action="PromotionCreate" method="post" class="card">
            <div class="form-group">
                <label asp-for="Title">Заголовок</label>
                <input asp-for="Title" class="custom-input" required />
            </div>
            <div class="form-group">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" class="custom-input" rows="3" required></textarea>
            </div>
            <div class="form-group">
                <label asp-for="Badge">Скидка</label>
                <input asp-for="Badge" class="custom-input" />
            </div>
            <div class="form-group">
                <label asp-for="ValidUntil">Действует до</label>
                <input asp-for="ValidUntil" type="date" class="custom-input" />
            </div>
            <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                <input asp-for="IsActive" type="checkbox" style="width: 20px; height: 20px;" />
                <label asp-for="IsActive" style="margin: 0;">Активна (отображать на сайте)</label>
            </div>
            <button type="submit" class="btn-submit" style="width: 100%;">Сохранить</button>
            <a asp-action="Promotions" style="display: block; text-align: center; margin-top: 15px;">Отмена</a>
        </form>
    </div>
</section>